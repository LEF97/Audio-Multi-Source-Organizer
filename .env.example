# ========================================================
# Audio Multi-Source Organizer (AMSO) — Variables d'environnement
# Copiez ce fichier sous le nom '.env' et complétez avec vos identifiants réels.
# ATTENTION : Ne commitez JAMAIS votre fichier '.env' réel !
# ========================================================

# --- Configuration Spotify API ---
# Obtenez vos clés sur : https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=votre_spotify_client_id_ici
SPOTIFY_CLIENT_SECRET=votre_spotify_client_secret_ici
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Configuration Google Drive API v3 ---
# Créez vos identifiants OAuth 2.0 sur la Google Cloud Console : https://console.cloud.google.com/
GDRIVE_CREDENTIALS_PATH=credentials.json
GDRIVE_TOKEN_PATH=token.json

# --- Configuration de l'Application Locale ---
AMSO_DB_PATH=amso_library.db
AMSO_LOG_LEVEL=INFO
